# Chicago Data Portal — register free at:
# https://data.cityofchicago.org/profile/edit/developer
#
# Key ID     = public app token → SOCRATA_APP_TOKEN
# Key Secret = private          → SOCRATA_APP_SECRET
#
# For read-only public data, only the Key ID (app token) is required.
# The secret enables HTTP Basic Auth for higher rate limits.
#
# Copy this file to .env and fill in your credentials.
# Never commit .env to version control.
SOCRATA_APP_TOKEN=YOUR_APP_TOKEN_HERE
SOCRATA_APP_SECRET=YOUR_APP_SECRET_HERE
