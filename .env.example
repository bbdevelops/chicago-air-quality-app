# Chicago Data Portal — register free at:
# https://data.cityofchicago.org/profile/edit/developer
#
# Key ID     = public app token → SOCRATA_APP_TOKEN
# Key Secret = private          → SOCRATA_APP_SECRET
#
# For read-only public data, only the Key ID (app token) is required.
# The secret enables HTTP Basic Auth for higher rate limits.
#
# Copy this file to .env and fill in your credentials.
# Never commit .env to version control.
SOCRATA_APP_TOKEN=YOUR_APP_TOKEN_HERE
SOCRATA_APP_SECRET=YOUR_APP_SECRET_HERE

# EPA Air Quality System (AQS) API — regulatory reference monitor data.
# Register for a free key (you supply an email; the key is emailed to you):
#   https://aqs.epa.gov/aqsweb/documents/data_api.html#signup
# Used by scripts/extract_epa.py to pull Cook County FRM/FEM monitor readings.
EPA_API_EMAIL=your_email@example.com
EPA_API_KEY=YOUR_EPA_AQS_KEY_HERE
